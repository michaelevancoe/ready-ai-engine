{
  "name": "ready-ai-engine-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "test:e2e": "playwright test",
    "test:e2e:account": "READY_ACCOUNT_E2E=1 playwright test -c playwright.account.config.ts",
    "test:built": "npm run build:vinext && playwright test -c playwright.built.config.ts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@radix-ui/react-label": "2.1.17",
    "@vinext/cloudflare": "^1.3.4",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.17",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-beta.32",
    "typescript": "7.0.2",
    "vite": "^8.3.0"
  }
}
